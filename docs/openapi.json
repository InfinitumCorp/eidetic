  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Cumulus ID session token."
      }
    },
    "headers": {
      "RequestId": {
        "description": "The caller's well-formed X-Request-Id, or a new one.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Refused or failed. The body says whether a match ran.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "matchRan",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "A stable code such as CONSENT_REQUIRED, FORBIDDEN or VALIDATION."
              },
              "message": {
                "type": "string",
                "description": "A sentence a person can act on."
              },
              "matchRan": {
                "type": "boolean",
                "description": "Whether a biometric match ran before the refusal. Almost always false."
              },
              "requestId": {
                "type": "string",
                "description": "Matches the X-Request-Id header. Quote it when asking for support."
              }
            }
          }
        }
      },
      "EnrollRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "cid": {
            "type": "string",
            "pattern": "^cid:\\/\\/infinitum\\/[a-z0-9-]{3,80}$"
          },
          "legalBasis": {
            "type": "string",
            "enum": [
              "consent",
              "contract",
              "legal_obligation"
            ]
          },
          "purposes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "purposeCode": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,64}$"
                },
                "datasetIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,64}$"
                  }
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "purposeCode",
                "datasetIds"
              ]
            }
          },
          "recordAttributes": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 80
            }
          },
          "fixtureId": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,64}$"
          },
          "imageBase64": {
            "type": "string",
            "maxLength": 700000
          }
        },
        "required": [
          "displayName",
          "legalBasis",
          "purposes"
        ]
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "purposeCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "legalBasis": {
            "type": "string",
            "enum": [
              "consent",
              "contract",
              "legal_obligation"
            ]
          },
          "datasetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "edition": {
            "default": "business",
            "type": "string",
            "enum": [
              "civilian",
              "business",
              "mil"
            ]
          },
          "subjectCid": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120
          },
          "recordHints": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 80
            }
          },
          "fixtureId": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,64}$"
          },
          "imageBase64": {
            "type": "string",
            "maxLength": 700000
          },
          "routing": {
            "type": "object",
            "properties": {
              "ip": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "domain": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              }
            }
          }
        },
        "required": [
          "purposeCode",
          "legalBasis",
          "datasetId"
        ]
      },
      "GeoRoutingSettings": {
        "type": "object",
        "properties": {
          "geoRouting": {
            "type": "boolean"
          }
        },
        "required": [
          "geoRouting"
        ]
      },
      "GeoLookupRequest": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        }
      },
      "PurposeRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 8,
            "maxLength": 400
          },
          "edition": {
            "type": "string",
            "enum": [
              "civilian",
              "business"
            ]
          },
          "legalBases": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "consent",
                "contract",
                "legal_obligation"
              ]
            }
          },
          "datasetIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,64}$"
            }
          },
          "allowedRoles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "admin",
                "operator",
                "reviewer",
                "auditor"
              ]
            }
          },
          "active": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "title",
          "description",
          "edition",
          "legalBases",
          "datasetIds",
          "allowedRoles"
        ]
      },
      "DecisionRequest": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "confirm",
              "reject",
              "inconclusive"
            ]
          },
          "selectedCid": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2000
          }
        },
        "required": [
          "decision",
          "notes"
        ]
      },
      "BiasEvaluationRequest": {
        "type": "object",
        "properties": {
          "releaseId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,64}$"
          },
          "cases": {
            "minItems": 1,
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "group": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
                },
                "expectedCid": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 120
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "predictedCid": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 120
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "group",
                "expectedCid",
                "predictedCid",
                "confidence"
              ]
            }
          }
        },
        "required": [
          "releaseId",
          "cases"
        ]
      },
      "BiasFixtureEvaluationRequest": {
        "type": "object",
        "properties": {
          "releaseId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,64}$"
          },
          "cases": {
            "minItems": 1,
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "fixtureId": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{3,64}$"
                },
                "expectedCid": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 120
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "predictedCid": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 120
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "fixtureId",
                "expectedCid",
                "predictedCid",
                "confidence"
              ]
            }
          }
        },
        "required": [
          "releaseId",
          "cases"
        ]
      },
      "AuditQuery": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "before": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z_]{1,40}$"
          }
        }
      }
    }
  }
}
