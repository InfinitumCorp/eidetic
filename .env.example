# Local demo configuration for ei·det·ic™.
# Copy to .env. Demo bearer tokens are not production credentials.

PORT=43110
DATABASE_URL=postgres://eidetic:eidetic@127.0.0.1:5432/eidetic
BIOMETRIC_STORE_PATH=data/templates
MATCHER_MODE=mock
CAPTURE_PROVIDER=local
MIL_ENABLED=false
DEMO_MODE=true

# InsightFace weights are often noncommercial. Leave these unset in CI.
# INSIGHTFACE_LICENSE_ACCEPTED=false
# INSIGHTFACE_URL=http://127.0.0.1:43120
# OPENCV_MEDIAPIPE_URL=http://127.0.0.1:43121
# EIDETIC_ALLOW_OPERATOR_CAPTURES=false

# HMAC key for Firmament checkpoints. Unset uses the development key.
# AUDIT_SIGNING_KEY=

# Optional adapters. Leave unset to keep the local implementations.
# OPA_URL=http://127.0.0.1:8181
# FIDES_URL=
# PRESIDIO_URL=
# KEYCLOAK_ISSUER=https://idp.example/realms/eidetic
