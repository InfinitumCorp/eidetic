# Local demo configuration for ei·det·ic™.
# Copy to .env. Demo bearer tokens are not production credentials.

PORT=43110
DATABASE_URL=postgres://eidetic:eidetic@127.0.0.1:5432/eidetic
BIOMETRIC_STORE_PATH=data/templates
MATCHER_MODE=mock
CAPTURE_PROVIDER=local
MIL_ENABLED=false
DEMO_MODE=true

# Most searches one account may start in a rolling hour. 0 turns the limit off.
# SEARCH_LIMIT_PER_HOUR=120
# Browser origins allowed to call the API cross-origin, comma-separated.
# Unset allows the local desks on ports 43111 and 43112. Desks behind the Compose proxy are same-origin.
# ALLOWED_ORIGINS=https://review.example.com,https://purpose.example.com

# Recommended non-mock matcher. Weights are downloaded by pnpm matcher:fetch-models.
# YuNet is MIT. SFace is Apache-2.0. See NOTICE.
# MATCHER_MODE=opencv-zoo
# OPENCV_ZOO_MODEL_DIR=data/models/opencv-zoo

# InsightFace weights are often noncommercial. Leave these unset.
# INSIGHTFACE_LICENSE_ACCEPTED=false
# INSIGHTFACE_URL=http://127.0.0.1:43120
# OPENCV_MEDIAPIPE_URL=http://127.0.0.1:43121
# EIDETIC_ALLOW_OPERATOR_CAPTURES=false

# Audit signatures are Ed25519. Demo mode writes data/audit-ed25519.pem.
# AUDIT_SIGNER=env
# AUDIT_ED25519_KEY_PATH=
# AUDIT_SIGNER=openbao
# OPENBAO_ADDR=http://127.0.0.1:8200
# OPENBAO_TOKEN=
# OPENBAO_TRANSIT_KEY=eidetic-audit

# People sign in with Cumulus ID. Roles by Cumulus ID (comma or space separated).
# Production (DEMO_MODE=false) requires CID_ADMINS and a real audit signer.
CID_ISSUER=https://id.cumuluscloud.app
# CID_ISSUER_MIRROR=          # tried only when CID_ISSUER is unreachable (e.g. a mirror that loads in Russia)
CID_ADMINS=
CID_REVIEWERS=
# CID_OPERATORS=
# CID_AUDITORS=
# VITE_CID_ISSUER=            # issuer the desks send people to; defaults to https://id.cumuluscloud.app

# Local development only: accept the seeded dev-* bearer tokens. Refused when DEMO_MODE=false.
# EIDETIC_DEV_BEARER=true
# VITE_EIDETIC_DEV_BEARER=dev-admin

# Optional machine-to-machine tokens from a Keycloak realm.
# KEYCLOAK_ISSUER=https://idp.example/realms/eidetic
# KEYCLOAK_AUDIENCE=eidetic-api
# KEYCLOAK_JWKS_URL=

# Optional adapters. Leave unset to keep the local implementations.
# OPA_URL=http://127.0.0.1:8181
# FIDES_URL=
# PRESIDIO_URL=

# @conjure: hosted Conjure prediction service. Key from the Conjure staff dashboard; server-side only.
CONJURE_URL=
CONJURE_PRODUCT_KEY=
# @scalvs / @scalus: the SCALVS agent on your OpenClaw gateway. Off until both are set (and always off on MIL); the token is a server secret.
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_AGENT=openclaw

# Public Amplitude API key for the purpose and review desks (not the Secret key).
# Optional: packages/analytics already has the public key as a fallback.
# VITE_AMPLITUDE_API_KEY=
