# Local demo configuration for ei·det·ic™.
# Copy to .env. Demo bearer tokens are not production credentials.

PORT=43110
DATABASE_URL=postgres://eidetic:eidetic@127.0.0.1:5432/eidetic
BIOMETRIC_STORE_PATH=data/templates
MATCHER_MODE=mock
CAPTURE_PROVIDER=local
MIL_ENABLED=false
DEMO_MODE=true

# Recommended non-mock matcher. Weights are downloaded by pnpm matcher:fetch-models.
# YuNet is MIT. SFace is Apache-2.0. See NOTICE.
# MATCHER_MODE=opencv-zoo
# OPENCV_ZOO_MODEL_DIR=data/models/opencv-zoo

# InsightFace weights are often noncommercial. Leave these unset.
# INSIGHTFACE_LICENSE_ACCEPTED=false
# INSIGHTFACE_URL=http://127.0.0.1:43120
# OPENCV_MEDIAPIPE_URL=http://127.0.0.1:43121
# EIDETIC_ALLOW_OPERATOR_CAPTURES=false

# Audit signatures are Ed25519. Demo mode writes data/audit-ed25519.pem.
# AUDIT_SIGNER=env
# AUDIT_ED25519_KEY_PATH=
# AUDIT_SIGNER=openbao
# OPENBAO_ADDR=http://127.0.0.1:8200
# OPENBAO_TOKEN=
# OPENBAO_TRANSIT_KEY=eidetic-audit

# Production (DEMO_MODE=false) requires Keycloak and a real audit signer.
# KEYCLOAK_ISSUER=https://idp.example/realms/eidetic
# KEYCLOAK_AUDIENCE=eidetic-api
# KEYCLOAK_JWKS_URL=

# Optional adapters. Leave unset to keep the local implementations.
# OPA_URL=http://127.0.0.1:8181
# FIDES_URL=
# PRESIDIO_URL=

# @conjure: hosted Conjure prediction service. Key from the Conjure staff dashboard; server-side only.
CONJURE_URL=
CONJURE_PRODUCT_KEY=
