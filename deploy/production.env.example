# ei·det·ic API: production settings. Copy to your secret store, never commit real values.
# The API image sets NODE_ENV=production and refuses to start in demo mode.

DEMO_MODE=false
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/eidetic
BIOMETRIC_STORE_PATH=/data/templates

# Audit signing: OpenBao Transit (preferred) or an Ed25519 private key. One is required.
AUDIT_SIGNER=openbao
OPENBAO_ADDR=
OPENBAO_TOKEN=
OPENBAO_TRANSIT_KEY=
# AUDIT_SIGNER=env
# AUDIT_ED25519_KEY_PATH=/run/secrets/audit-ed25519.pem   # openssl genpkey -algorithm ed25519 -out audit-ed25519.pem

# Sign-in: Cumulus ID. At least one admin is required.
CID_ISSUER=https://id.cumuluscloud.app
CID_ISSUER_MIRROR=
CID_ADMINS=
CID_REVIEWERS=
CID_OPERATORS=
CID_AUDITORS=

# Matching stays on the mock matcher until a licensed or MIT/Apache model path is chosen.
MATCHER_MODE=mock
CAPTURE_PROVIDER=local
MIL_ENABLED=false
SEARCH_LIMIT_PER_HOUR=120

# Optional services. Unset means the embedded/local fallback.
OPA_URL=
FIDES_URL=
# Only needed when the desks are served from another origin than the API.
ALLOWED_ORIGINS=
